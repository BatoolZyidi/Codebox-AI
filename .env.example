# ===== Codebox AI settings =====
# Copy this file to ".env" (same folder) and paste your keys. Never share or commit ".env".

# Required
ASSEMBLYAI_API_KEY=
GEMINI_API_KEY=

# Voice phrases (say these out loud)
WAKE_PHRASE=wakeup codebox AI
CLOSE_PHRASE=close yourself codebox AI
# What the close phrase does: "sleep" = keep listening for the wake phrase (recommended),
#                             "exit"  = stop the program completely
CLOSE_ACTION=sleep
# Go back to sleep by itself after this many idle seconds (0 = never)
IDLE_TIMEOUT_SECONDS=0

# Optional - project folder to work on (or use --repo on the command line)
# CODEBOX_REPO=C:\Users\you\my-project

# MIC_DEVICE=            # device number or part of its name; list them with: python -m codebox devices
# TTS_ENABLED=true
# TTS_RATE=1.0           # speaking speed: 0.8 slower ... 1.5 faster
# ECHO_TAIL_SECONDS=1.0

